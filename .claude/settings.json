{
  "permissions": {
    "allow": [
      "Bash(.spec/bin/spec *)",
      "Bash(./.spec/bin/spec *)",
      "Skill(spec:brief)",
      "Skill",
      "Bash(npx vitest *)"
    ],
    "additionalDirectories": [
      "../spec.worktrees"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.spec/bin/spec hook claude-code session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.spec/bin/spec hook claude-code before-edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.spec/bin/spec hook claude-code after-edit"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "spec@happyface": false
  }
}
