@@ -0,0 +1,12 @@
+// Which provider handles a request: the active one for a new message, the fallback after a rate limit.
+import type { ProviderConfig, ProviderId } from './config';
+
+/** The active provider when it is enabled, else null. */
+export function activeProvider(config: ProviderConfig): ProviderId | null {
+  return config.enabled.includes(config.active) ? config.active : null;
+}
+
+/** The fallback provider when one is set and enabled, else null. */
+export function fallbackProvider(config: ProviderConfig): ProviderId | null {
+  return config.fallback !== null && config.enabled.includes(config.fallback) ? config.fallback : null;
+}
